							"type": "color",
							"content": ["id_qmk_rgb_matrix_color", 3, 4]
						}
					]
				},
				{
					"label": "Side Light",
					"content":
					[
						{
							"label": "Brightness",
							"type": "range",
							"options": [0, 12],
							"content": ["id_side_brightness", 4, 1]
						},
						{
							"label": "Effect",
							"type": "dropdown",
							"content": ["id_side_effect", 4, 2],
							"options":
							[
								[ "Off", 0 ],
								[ "Rainbow wave", 1 ],
								[ "Single colour wave", 2 ],
								[ "Spectrum", 3 ],
								[ "Breathing", 4 ],
								[ "Solid colour", 5 ]
							]
						},
						{
							"showIf": "{id_side_effect} != 0 && {id_side_effect} != 5",
							"label": "Effect Speed",
							"type": "range",
							"options": [0, 4],
							"content": ["id_side_speed", 4, 3]
						},
						{
							"showIf": "{id_side_effect} == 2 || {id_side_effect} == 4 || {id_side_effect} == 5",
							"label": "Color",
							"type": "color",
							"content": ["id_side_color", 4, 4]
						}
					]
				}
			]
		}
