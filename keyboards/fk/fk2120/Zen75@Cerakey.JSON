							"type": "range",
							"options": [0, 255],
							"content": ["id_qmk_rgb_matrix_effect_speed", 3, 3]
						},
						{
							"showIf": "{id_qmk_rgb_matrix_effect} != 0 && {id_qmk_rgb_matrix_effect} != 25 && {id_qmk_rgb_matrix_effect} != 29 && {id_qmk_rgb_matrix_effect} != 30",
